# ============================================================
# このファイルを .env にコピーして値を設定してください。
# ============================================================

# GAS Web App のデプロイURL（未設定の場合はモックモードで動作し、保存は console 出力のみ）
VITE_GAS_WEBAPP_URL=https://script.google.com/macros/s/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx/exec

# Gemini API キー
VITE_GEMINI_API_KEY=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 使用モデル（省略時: gemini-3.8-flash）
VITE_GEMINI_MODEL=gemini-3.8-flash

# 新規作成した実験用スプレッドシートのID（後から設定可能）
VITE_SPREADSHEET_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# 音声保存先 Google ドライブフォルダID
VITE_DRIVE_FOLDER_ID=xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

